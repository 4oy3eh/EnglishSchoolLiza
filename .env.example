# Copy to `.env` and adjust. Loaded by app/core/config.py (pydantic-settings).

# --- App ---
APP_NAME=english-exam
# dev | test = local development. Leave it OUT (or set anything else, e.g.
# production) on a real deployment: the code default is "production", so a
# server that configures nothing is never treated as a dev server.
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Database ---
# Dev/test default to a local sqlite file. For Postgres use e.g.:
# DATABASE_URL=postgresql+psycopg://exam:exam@localhost:5432/english_exam
DATABASE_URL=sqlite:///./english_exam.db
DB_ECHO=false

# --- Teacher dashboard auth ---
# The built-in defaults (password `change-me` + a public token secret) are
# accepted ONLY when ENVIRONMENT is explicitly dev/test AND the request comes from
# this machine (http://127.0.0.1:8000 / localhost, not through ngrok / a proxy /
# another device). Anywhere else the dashboard answers 503 until BOTH are set.
# Set them before sharing the dashboard (tunnel, LAN, server):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# TEACHER_PASSWORD=
# ADMIN_TOKEN_SECRET=
# ADMIN_TOKEN_TTL_SECONDS=28800
# Wrong-password limits per sliding window: per client IP, and from everyone
# together (the real brute-force bound; 0 = off). Behind a reverse proxy on
# another host run uvicorn with `--proxy-headers --forwarded-allow-ips=<proxy ip>`,
# otherwise all clients share the proxy's IP as one key.
# LOGIN_MAX_FAILURES=10
# LOGIN_GLOBAL_MAX_FAILURES=30
# LOGIN_WINDOW_SECONDS=300

# --- Timed sections (IQ tests) ---
# Longest an untimed intro / sample screen may stay open before the subtest begins
# by itself (also the per-subtest allowance in the attempt's overall deadline). It
# covers all three intro screens (instructions, example + practice, ready).
# SECTION_INTRO_MAX_SECONDS=420

# Longest text answer (chars) a student save may carry, any item type. Keep it above
# the biggest colour_task picture (a PNG data URL, ~0.5-2 M chars). Drawings have
# their own fixed 300 000 cap.
# ANSWER_MAX_CHARS=4000000

# --- Writing auto-grading (Gemini) ---
# Paste your Google AI Studio key into your local `.env` (which is gitignored —
# never commit a real key). When set, writing is auto-graded by Gemini at submit
# time and the dashboard shows per-skill feedback; leave EMPTY to send writing to
# the manual review queue instead. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Integrity verdict: optional Gemini "second opinion" on writing ---
# EN: The cheating verdict (suspicion, ranking, rule cards) always comes from the
#     deterministic rule engine - no AI involved. This switch only adds an extra
#     Gemini call that gives a second opinion on the WRITING answers:
#       writing = ask Gemini about writing only (needs GEMINI_API_KEY; without a
#                 key it behaves like "off")
#       off     = never call Gemini for the integrity analysis
#     Writing grading and per-skill feedback are separate calls and stay as they are.
# RU: Вердикт о списывании (подозрение, сортировка, карточки правил) всегда строится
#     детерминированными правилами - без ИИ. Этот переключатель лишь добавляет
#     отдельный запрос к Gemini - "второе мнение" по ПИСЬМЕННЫМ ответам:
#       writing = спрашивать Gemini только о письме (нужен GEMINI_API_KEY; без
#                 ключа работает как "off")
#       off     = никогда не обращаться к Gemini для анализа честности
#     Оценивание письма и отзыв по навыкам - отдельные запросы, на них это не влияет.
ANALYSIS_LLM=writing
