# Claude Code local config (agents, commands, hooks, settings)
.claude/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Env / secrets
.env
.env.*
# Keep the committed template tracked (documents vars; carries NO real secrets).
!.env.example
*.local

# Alembic / DB
*.sqlite3
*.db
*.db-wal
*.db-shm
# Database backups (scripts/backup_db.py, BACKUP_DIR default)
/backups/

# Media / assets ingested locally
/uploads/
/media/
# Local runtime data: asset blobs (FilesystemStorage default ./var/assets), etc.
/var/
*.mp3
*.wav
# Local Cambridge sample materials (copyright) + their generated transcripts —
# keep out of the repo; they live on the developer's machine only.
/assets/

# Commercial / licensed source books (e.g. the 1993 "Cambridge Self-Scoring IQ
# Test", © Dan Pape) and everything transcribed from them: items, answer keys,
# norm tables, image crops. Copyright forbids reproduction and this repo is
# public — this content lives on the developer's machine only. Code that
# consumes it ships; the data never does.
/pdf/
/private/

# Exception: the committed deploy fixtures DO ship the test audio (via git-lfs)
# so a fresh container/web deploy has real content. See deploy/fixtures/.
!/deploy/fixtures/assets/*.mp3

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log

# Node (web frontend, if any)
node_modules/
dist/
build/
