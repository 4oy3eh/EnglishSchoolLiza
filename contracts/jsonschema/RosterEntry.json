{
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attempt Id"
    },
    "display_name": {
      "title": "Display Name",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "papers": {
      "anyOf": [
        {
          "items": {
            "enum": [
              "reading_writing",
              "reading",
              "reading_use_of_english",
              "writing",
              "listening"
            ],
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The papers this student is assigned (teacher's choice, e.g. only ['listening']); None = the whole test. Validated against the test's papers (`contracts.papers.normalize_papers`); changeable only before the student starts. Snapshotted on `Attempt.papers` at start.",
      "title": "Papers"
    },
    "pin": {
      "anyOf": [
        {
          "pattern": "^[A-HJKMNP-Z2-9]{4}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "4-character classroom PIN the student types to start/resume (teacher-only; never served by the student roster list). Generated server-side when the entry is persisted if None.",
      "title": "Pin"
    },
    "status": {
      "default": "not_started",
      "enum": [
        "not_started",
        "in_progress",
        "submitted",
        "expired"
      ],
      "title": "Status",
      "type": "string"
    },
    "test_id": {
      "title": "Test Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "test_id",
    "display_name"
  ],
  "title": "RosterEntry",
  "type": "object"
}
