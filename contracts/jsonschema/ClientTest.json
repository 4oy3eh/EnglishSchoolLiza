{
  "$defs": {
    "AudioAssetStimulus": {
      "additionalProperties": false,
      "description": "A listening recording. Each listening section may carry its OWN track.\n\nPer-part audio (Cambridge YLE ships one mp3 per part): consecutive listening\nsections form one *track* while their `asset_id` stays the same; a section whose\n`asset_id` differs from the previous audio section's starts a NEW track, and a\nlistening section with a non-audio stimulus (e.g. a matching pool) continues the\ncurrent one. The track's settings (`plays`, `locked`, `preview_asset_id`) come\nfrom the section that starts it. Tracks play strictly in order (the runner never\nlets a later part's track start before the current one has ended); the\nfurthest position per track (`asset_id`) is stored server-side\n(`AudioTrackProgress`). One `asset_id` may only be used by consecutive sections\n(the editor refuses A, B, A).",
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "images": {
          "description": "Optional context image asset_ids shown beside this stimulus.",
          "items": {
            "type": "string"
          },
          "title": "Images",
          "type": "array"
        },
        "kind": {
          "const": "audio_asset",
          "default": "audio_asset",
          "title": "Kind",
          "type": "string"
        },
        "locked": {
          "default": true,
          "description": "When true the main track cannot be paused, seeked, or replayed once started (leaving/answering does not stop it); the preview clip stays free.",
          "title": "Locked",
          "type": "boolean"
        },
        "look_through_seconds": {
          "default": 0,
          "minimum": 0,
          "title": "Look Through Seconds",
          "type": "integer"
        },
        "plays": {
          "default": 1,
          "description": "Replay limit for the main track. Default 1: Cambridge recordings already bake in the double play, so the online track is played once start-to-end.",
          "minimum": 1,
          "title": "Plays",
          "type": "integer"
        },
        "preview_asset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional sound-check / instructions clip (the recording's opening explanation), played BEFORE the main track and freely replayable.",
          "title": "Preview Asset Id"
        }
      },
      "required": [
        "asset_id"
      ],
      "title": "AudioAssetStimulus",
      "type": "object"
    },
    "ClientColourTaskItem": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "item_type": {
          "const": "colour_task",
          "default": "colour_task",
          "title": "Item Type",
          "type": "string"
        },
        "palette": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Palette",
          "type": "array"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        }
      },
      "required": [
        "id",
        "prompt",
        "asset_id",
        "palette"
      ],
      "title": "ClientColourTaskItem",
      "type": "object"
    },
    "ClientGapFillItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "item_type": {
          "const": "gap_fill",
          "default": "gap_fill",
          "title": "Item Type",
          "type": "string"
        },
        "max_words": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "'Use no more than N word(s)' (None = no limit shown).",
          "title": "Max Words"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "stem_word": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Word-formation stem shown beside the gap, e.g. 'COMPETE'.",
          "title": "Stem Word"
        }
      },
      "required": [
        "id",
        "prompt"
      ],
      "title": "ClientGapFillItem",
      "type": "object"
    },
    "ClientImageOption": {
      "additionalProperties": false,
      "properties": {
        "alt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alt"
        },
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "kind": {
          "const": "image",
          "default": "image",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "asset_id"
      ],
      "title": "ClientImageOption",
      "type": "object"
    },
    "ClientKeyWordTransformationItem": {
      "additionalProperties": false,
      "description": "The student's view of a key word transformation - no `answers`.\n\nRender: the lead-in `prompt`, the `key_word` (bold capitals), then\n`gapped_sentence` split at its first `KWT_GAP_RE` match with ONE text input in\nthe gap, plus the rubric \"Use between `min_words` and `max_words` words,\nincluding the word given.\" The answer is saved as plain text (the words typed\ninto the gap only).",
      "properties": {
        "gapped_sentence": {
          "title": "Gapped Sentence",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "item_type": {
          "const": "key_word_transformation",
          "default": "key_word_transformation",
          "title": "Item Type",
          "type": "string"
        },
        "key_word": {
          "title": "Key Word",
          "type": "string"
        },
        "max_words": {
          "minimum": 1,
          "title": "Max Words",
          "type": "integer"
        },
        "min_words": {
          "minimum": 1,
          "title": "Min Words",
          "type": "integer"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        }
      },
      "required": [
        "id",
        "prompt",
        "key_word",
        "gapped_sentence",
        "min_words",
        "max_words"
      ],
      "title": "ClientKeyWordTransformationItem",
      "type": "object"
    },
    "ClientMatchingItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "item_type": {
          "const": "matching",
          "default": "matching",
          "title": "Item Type",
          "type": "string"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        }
      },
      "required": [
        "id",
        "prompt"
      ],
      "title": "ClientMatchingItem",
      "type": "object"
    },
    "ClientOpenWritingItem": {
      "additionalProperties": false,
      "properties": {
        "bullet_points": {
          "items": {
            "type": "string"
          },
          "title": "Bullet Points",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "item_type": {
          "const": "open_writing",
          "default": "open_writing",
          "title": "Item Type",
          "type": "string"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "word_min": {
          "exclusiveMinimum": 0,
          "title": "Word Min",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "prompt",
        "word_min"
      ],
      "title": "ClientOpenWritingItem",
      "type": "object"
    },
    "ClientSection": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "items": {
          "items": {
            "discriminator": {
              "mapping": {
                "colour_task": "#/$defs/ClientColourTaskItem",
                "gap_fill": "#/$defs/ClientGapFillItem",
                "key_word_transformation": "#/$defs/ClientKeyWordTransformationItem",
                "matching": "#/$defs/ClientMatchingItem",
                "open_writing": "#/$defs/ClientOpenWritingItem",
                "single_choice": "#/$defs/ClientSingleChoiceItem"
              },
              "propertyName": "item_type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ClientSingleChoiceItem"
              },
              {
                "$ref": "#/$defs/ClientGapFillItem"
              },
              {
                "$ref": "#/$defs/ClientMatchingItem"
              },
              {
                "$ref": "#/$defs/ClientOpenWritingItem"
              },
              {
                "$ref": "#/$defs/ClientColourTaskItem"
              },
              {
                "$ref": "#/$defs/ClientKeyWordTransformationItem"
              }
            ]
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "skill": {
          "anyOf": [
            {
              "enum": [
                "reading",
                "listening",
                "writing"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill"
        },
        "stimulus": {
          "discriminator": {
            "mapping": {
              "audio_asset": "#/$defs/AudioAssetStimulus",
              "gapped_text": "#/$defs/GappedTextStimulus",
              "image_set": "#/$defs/ImageSetStimulus",
              "matching_pool": "#/$defs/MatchingPoolStimulus",
              "passage_text": "#/$defs/PassageTextStimulus"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PassageTextStimulus"
            },
            {
              "$ref": "#/$defs/AudioAssetStimulus"
            },
            {
              "$ref": "#/$defs/ImageSetStimulus"
            },
            {
              "$ref": "#/$defs/GappedTextStimulus"
            },
            {
              "$ref": "#/$defs/MatchingPoolStimulus"
            }
          ],
          "title": "Stimulus"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "id",
        "stimulus",
        "items"
      ],
      "title": "ClientSection",
      "type": "object"
    },
    "ClientSingleChoiceItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image"
        },
        "item_type": {
          "const": "single_choice",
          "default": "single_choice",
          "title": "Item Type",
          "type": "string"
        },
        "options": {
          "items": {
            "discriminator": {
              "mapping": {
                "image": "#/$defs/ClientImageOption",
                "text": "#/$defs/ClientTextOption"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ClientTextOption"
              },
              {
                "$ref": "#/$defs/ClientImageOption"
              }
            ]
          },
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        }
      },
      "required": [
        "id",
        "prompt",
        "options"
      ],
      "title": "ClientSingleChoiceItem",
      "type": "object"
    },
    "ClientTextOption": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "text",
          "default": "text",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "ClientTextOption",
      "type": "object"
    },
    "GappedTextStimulus": {
      "additionalProperties": false,
      "properties": {
        "images": {
          "description": "Optional context image asset_ids shown beside this stimulus.",
          "items": {
            "type": "string"
          },
          "title": "Images",
          "type": "array"
        },
        "kind": {
          "const": "gapped_text",
          "default": "gapped_text",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "description": "Passage text with gap markers (PET Reading Part 4).",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "GappedTextStimulus",
      "type": "object"
    },
    "ImageSetStimulus": {
      "additionalProperties": false,
      "properties": {
        "asset_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Asset Ids",
          "type": "array"
        },
        "kind": {
          "const": "image_set",
          "default": "image_set",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "asset_ids"
      ],
      "title": "ImageSetStimulus",
      "type": "object"
    },
    "MatchingPoolStimulus": {
      "additionalProperties": false,
      "properties": {
        "audio": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioAssetStimulus"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The recording a LISTENING matching part plays (C1/C2 Listening Part 4: two parallel tasks, each with its own A-H pool, over one recording). It opens / continues a listening track exactly like an `audio_asset` stimulus: consecutive sections with the same `audio.asset_id` share ONE track (played once for both tasks). None = the part continues the current track."
        },
        "each_option_once": {
          "default": false,
          "description": "True = every option fits at most ONE question (a gapped text: B2 Reading Part 6, C1 Part 7, C2 Part 6 - one option is a distractor); the runner greys out an option already used in this part. False = options are reusable (multiple matching: 'some options may be correct for more than one question'). Display hint only - grading compares each item's key.",
          "title": "Each Option Once",
          "type": "boolean"
        },
        "images": {
          "description": "Optional context image asset_ids shown beside this stimulus.",
          "items": {
            "type": "string"
          },
          "title": "Images",
          "type": "array"
        },
        "kind": {
          "const": "matching_pool",
          "default": "matching_pool",
          "title": "Kind",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/PoolOption"
          },
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "text": {
          "default": "",
          "description": "Optional passage/intro shown above the A-H pool (e.g. a gapped text).",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "options"
      ],
      "title": "MatchingPoolStimulus",
      "type": "object"
    },
    "PassageTextStimulus": {
      "additionalProperties": false,
      "properties": {
        "images": {
          "description": "Optional context image asset_ids shown beside this stimulus.",
          "items": {
            "type": "string"
          },
          "title": "Images",
          "type": "array"
        },
        "kind": {
          "const": "passage_text",
          "default": "passage_text",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "PassageTextStimulus",
      "type": "object"
    },
    "PoolOption": {
      "additionalProperties": false,
      "description": "One option in a section-level matching pool (A-H). No correctness here.",
      "properties": {
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional picture of this option (asset_id), e.g. the picture beside each word in a YLE word box. Served: the runner shows it above the word on the word-bank chip / letter button (alt = the option text). Not answer data.",
          "title": "Image"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "key",
        "text"
      ],
      "title": "PoolOption",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "duration_minutes": {
      "exclusiveMinimum": 0,
      "title": "Duration Minutes",
      "type": "integer"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "level": {
      "enum": [
        "PRE_A1_STARTERS",
        "A1_MOVERS",
        "A2_FLYERS",
        "A2_KEY",
        "B1_PRELIMINARY",
        "B2_FIRST",
        "C1_ADVANCED",
        "C2_PROFICIENCY"
      ],
      "title": "Level",
      "type": "string"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/ClientSection"
      },
      "minItems": 1,
      "title": "Sections",
      "type": "array"
    },
    "title": {
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "level",
    "duration_minutes",
    "sections"
  ],
  "title": "ClientTest",
  "type": "object"
}
