{
  "$defs": {
    "ItemGrade": {
      "additionalProperties": false,
      "properties": {
        "awarded": {
          "minimum": 0,
          "title": "Awarded",
          "type": "number"
        },
        "feedback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Examiner feedback for writing (carried from the LLM grader); for a key_word_transformation the per-half verdict (Russian, e.g. '1/2: \u043f\u0435\u0440\u0432\u0430\u044f \u0447\u0430\u0441\u0442\u044c \u0432\u0435\u0440\u043d\u0430, \u0432\u0442\u043e\u0440\u0430\u044f \u043d\u0435\u0442'); None for other objective items.",
          "title": "Feedback"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "max_points": {
          "description": "Points this item counts toward `max_score`. 0 only for a choose-one writing task that is graded but not counted (the student wrote both).",
          "minimum": 0,
          "title": "Max Points",
          "type": "number"
        },
        "method": {
          "enum": [
            "single_choice",
            "gap_fill",
            "matching",
            "open_writing_llm",
            "open_writing_manual",
            "colour_manual",
            "key_word_transformation"
          ],
          "title": "Method",
          "type": "string"
        },
        "needs_review": {
          "default": false,
          "title": "Needs Review",
          "type": "boolean"
        }
      },
      "required": [
        "item_id",
        "awarded",
        "max_points",
        "method"
      ],
      "title": "ItemGrade",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "title": "Attempt Id",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ItemGrade"
      },
      "title": "Items",
      "type": "array"
    },
    "max_score": {
      "minimum": 0,
      "title": "Max Score",
      "type": "number"
    },
    "needs_review": {
      "default": false,
      "title": "Needs Review",
      "type": "boolean"
    },
    "score": {
      "minimum": 0,
      "title": "Score",
      "type": "number"
    }
  },
  "required": [
    "attempt_id",
    "score",
    "max_score"
  ],
  "title": "GradingResult",
  "type": "object"
}
