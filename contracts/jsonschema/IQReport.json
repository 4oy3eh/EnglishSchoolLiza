{
  "$defs": {
    "IQCompositeScore": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "open_bound": {
          "anyOf": [
            {
              "enum": [
                "above",
                "below"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "'above' = at least `score` (e.g. 130+), 'below' = under it.",
          "title": "Open Bound"
        },
        "scaled_sum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sum of the sections' scaled scores (None = incomplete).",
          "title": "Scaled Sum"
        },
        "score": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Norm score for the age group (an open bound's number).",
          "title": "Score"
        },
        "score_display": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "As the table prints it: '112', '130+', '<70'.",
          "title": "Score Display"
        },
        "section_ids": {
          "items": {
            "type": "string"
          },
          "title": "Section Ids",
          "type": "array"
        }
      },
      "required": [
        "key"
      ],
      "title": "IQCompositeScore",
      "type": "object"
    },
    "IQSectionScore": {
      "additionalProperties": false,
      "properties": {
        "raw": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Points awarded in this section (None = not graded).",
          "title": "Raw"
        },
        "raw_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Max"
        },
        "scaled": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None = no band covers the raw.",
          "title": "Scaled"
        },
        "section_id": {
          "title": "Section Id",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "section_id"
      ],
      "title": "IQSectionScore",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Per-section raw + scaled, composite sums and scores, the overall score and\nits bracket. `notes` say why something is missing or approximate (see\napp/grading/CLAUDE.md \"Norm scoring\"). Advisory, non-clinical.",
  "properties": {
    "age": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Age"
    },
    "age_group": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Age Group"
    },
    "attempt_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attempt Id"
    },
    "bracket": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bracket"
    },
    "composites": {
      "items": {
        "$ref": "#/$defs/IQCompositeScore"
      },
      "title": "Composites",
      "type": "array"
    },
    "final": {
      "const": "mean_of_composites",
      "default": "mean_of_composites",
      "title": "Final",
      "type": "string"
    },
    "note": {
      "default": "",
      "title": "Note",
      "type": "string"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "overall": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Rounded half-up.",
      "title": "Overall"
    },
    "overall_display": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "'125', or '125+' / '<70' when a composite was open-ended.",
      "title": "Overall Display"
    },
    "overall_exact": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Mean of the composite scores, unrounded.",
      "title": "Overall Exact"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/IQSectionScore"
      },
      "title": "Sections",
      "type": "array"
    },
    "test_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Test Id"
    }
  },
  "title": "IQReport",
  "type": "object"
}
