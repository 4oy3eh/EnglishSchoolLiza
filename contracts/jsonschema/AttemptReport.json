{
  "$defs": {
    "AnalysisVerdict": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "title": "Attempt Id",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "error": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why the LLM analyst was not used (`<ExceptionType>: message`); the verdict is then the deterministic-only fallback.",
          "title": "Error"
        },
        "flags": {
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "input_fingerprint": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fingerprint of the inputs this verdict was computed from (event count, last event id, digest of the analysis context), set by the results layer. An automatic retry reuses a stored LLM verdict whose fingerprint still matches instead of paying for the same analysis again. Not evidence; never shown.",
          "title": "Input Fingerprint"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "LLM id, for auditability. None = the deterministic-only verdict.",
          "title": "Model Id"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "suspicion_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Suspicion Score",
          "type": "number"
        },
        "writing": {
          "description": "Per-writing-item outside-help assessments.",
          "items": {
            "$ref": "#/$defs/WritingAssessment"
          },
          "title": "Writing",
          "type": "array"
        }
      },
      "required": [
        "attempt_id",
        "suspicion_score",
        "confidence",
        "summary"
      ],
      "title": "AnalysisVerdict",
      "type": "object"
    },
    "GradingResult": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "title": "Attempt Id",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/ItemGrade"
          },
          "title": "Items",
          "type": "array"
        },
        "max_score": {
          "minimum": 0,
          "title": "Max Score",
          "type": "number"
        },
        "needs_review": {
          "default": false,
          "title": "Needs Review",
          "type": "boolean"
        },
        "score": {
          "minimum": 0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "attempt_id",
        "score",
        "max_score"
      ],
      "title": "GradingResult",
      "type": "object"
    },
    "HiddenInterval": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "duration_ms"
      ],
      "title": "HiddenInterval",
      "type": "object"
    },
    "IntegrityProfile": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "title": "Attempt Id",
          "type": "string"
        },
        "device_changed": {
          "default": false,
          "description": "True if the attempt was resumed on a different device.",
          "title": "Device Changed",
          "type": "boolean"
        },
        "device_count": {
          "default": 0,
          "description": "Distinct device fingerprints seen across (re)starts.",
          "minimum": 0,
          "title": "Device Count",
          "type": "integer"
        },
        "fullscreen_exit_count": {
          "default": 0,
          "minimum": 0,
          "title": "Fullscreen Exit Count",
          "type": "integer"
        },
        "hidden_intervals": {
          "items": {
            "$ref": "#/$defs/HiddenInterval"
          },
          "title": "Hidden Intervals",
          "type": "array"
        },
        "pacing_cv": {
          "default": 0.0,
          "description": "Coefficient of variation of per-question pace.",
          "minimum": 0,
          "title": "Pacing Cv",
          "type": "number"
        },
        "paste_attempt_count": {
          "default": 0,
          "description": "Blocked paste/drop attempts anywhere in the exam.",
          "minimum": 0,
          "title": "Paste Attempt Count",
          "type": "integer"
        },
        "question_timings": {
          "items": {
            "$ref": "#/$defs/QuestionTiming"
          },
          "title": "Question Timings",
          "type": "array"
        },
        "systematicity_rate": {
          "default": 0.0,
          "description": "Fraction of questions showing the pattern.",
          "maximum": 1,
          "minimum": 0,
          "title": "Systematicity Rate",
          "type": "number"
        },
        "total_hidden_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Total Hidden Ms",
          "type": "integer"
        },
        "writing": {
          "description": "Per-writing-item features (open_writing).",
          "items": {
            "$ref": "#/$defs/WritingFeatures"
          },
          "title": "Writing",
          "type": "array"
        }
      },
      "required": [
        "attempt_id"
      ],
      "title": "IntegrityProfile",
      "type": "object"
    },
    "ItemGrade": {
      "additionalProperties": false,
      "properties": {
        "awarded": {
          "minimum": 0,
          "title": "Awarded",
          "type": "number"
        },
        "feedback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Examiner feedback for writing (carried from the LLM grader); None for objective items.",
          "title": "Feedback"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "max_points": {
          "exclusiveMinimum": 0,
          "title": "Max Points",
          "type": "number"
        },
        "method": {
          "enum": [
            "single_choice",
            "gap_fill",
            "matching",
            "open_writing_llm",
            "open_writing_manual",
            "colour_manual"
          ],
          "title": "Method",
          "type": "string"
        },
        "needs_review": {
          "default": false,
          "title": "Needs Review",
          "type": "boolean"
        }
      },
      "required": [
        "item_id",
        "awarded",
        "max_points",
        "method"
      ],
      "title": "ItemGrade",
      "type": "object"
    },
    "QuestionTiming": {
      "additionalProperties": false,
      "properties": {
        "interaction_count": {
          "minimum": 0,
          "title": "Interaction Count",
          "type": "integer"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "latency_ms": {
          "description": "Time spent before first answering.",
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "post_return_latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "visible -> answer latency after a hide.",
          "title": "Post Return Latency Ms"
        }
      },
      "required": [
        "item_id",
        "latency_ms",
        "interaction_count"
      ],
      "title": "QuestionTiming",
      "type": "object"
    },
    "SkillReport": {
      "additionalProperties": false,
      "properties": {
        "max_score": {
          "minimum": 0,
          "title": "Max Score",
          "type": "number"
        },
        "score": {
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "skill": {
          "enum": [
            "reading",
            "listening",
            "writing"
          ],
          "title": "Skill",
          "type": "string"
        },
        "strengths": {
          "description": "What the student did well in this skill.",
          "title": "Strengths",
          "type": "string"
        },
        "weaknesses": {
          "description": "What the student should work on.",
          "title": "Weaknesses",
          "type": "string"
        }
      },
      "required": [
        "skill",
        "score",
        "max_score",
        "strengths",
        "weaknesses"
      ],
      "title": "SkillReport",
      "type": "object"
    },
    "WritingAssessment": {
      "additionalProperties": false,
      "description": "Advisory likelihood that ONE writing answer was produced with outside help.\n\nOutside help = ChatGPT / translator / text copied from another device or tab /\ndictation. Advisory only: no score, never moves a grade (golden rule #2).",
      "properties": {
        "ai_assist_likelihood": {
          "maximum": 1,
          "minimum": 0,
          "title": "Ai Assist Likelihood",
          "type": "number"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "rationale": {
          "default": "",
          "description": "1-2 sentences for the teacher (Russian).",
          "title": "Rationale",
          "type": "string"
        },
        "signals": {
          "description": "The evidence tags the judgment rests on.",
          "items": {
            "type": "string"
          },
          "title": "Signals",
          "type": "array"
        }
      },
      "required": [
        "item_id",
        "ai_assist_likelihood"
      ],
      "title": "WritingAssessment",
      "type": "object"
    },
    "WritingFeatures": {
      "additionalProperties": false,
      "description": "Deterministic per-writing-item features (integrity layer, NO judgment of guilt).\n\nBuilt from the writing-field telemetry (`field_focus` / `writing_stats` /\n`input_burst` / `paste_attempt`), the `answer_change` snapshots, the visibility /\nblur / fullscreen events overlapping the writing window, and cheap text\nstatistics of the submitted text. `flags` are threshold facts documented in\n`app/integrity/CLAUDE.md` (e.g. \"text_appeared_without_typing\"), not a verdict.\nCarries no score (golden rule #2).",
      "properties": {
        "active_typing_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Active Typing Ms",
          "type": "integer"
        },
        "away_count": {
          "default": 0,
          "description": "Hides/blurs during the window.",
          "minimum": 0,
          "title": "Away Count",
          "type": "integer"
        },
        "blur_ms_while_writing": {
          "default": 0,
          "minimum": 0,
          "title": "Blur Ms While Writing",
          "type": "integer"
        },
        "chars_per_active_minute": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chars Per Active Minute"
        },
        "deleted_chars": {
          "default": 0,
          "minimum": 0,
          "title": "Deleted Chars",
          "type": "integer"
        },
        "final_length": {
          "default": 0,
          "description": "Chars in the final text.",
          "minimum": 0,
          "title": "Final Length",
          "type": "integer"
        },
        "flags": {
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "fullscreen_exits_while_writing": {
          "default": 0,
          "minimum": 0,
          "title": "Fullscreen Exits While Writing",
          "type": "integer"
        },
        "has_keystroke_telemetry": {
          "default": false,
          "description": "True when at least one writing_stats event exists.",
          "title": "Has Keystroke Telemetry",
          "type": "boolean"
        },
        "hidden_ms_while_writing": {
          "default": 0,
          "minimum": 0,
          "title": "Hidden Ms While Writing",
          "type": "integer"
        },
        "inter_key_mean_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inter Key Mean Ms"
        },
        "inter_key_p50_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inter Key P50 Ms"
        },
        "inter_key_p90_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inter Key P90 Ms"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "keystrokes": {
          "default": 0,
          "minimum": 0,
          "title": "Keystrokes",
          "type": "integer"
        },
        "long_word_share": {
          "default": 0.0,
          "description": "Share of words with >= 8 letters.",
          "maximum": 1,
          "minimum": 0,
          "title": "Long Word Share",
          "type": "number"
        },
        "max_non_keyboard_insert": {
          "default": 0,
          "minimum": 0,
          "title": "Max Non Keyboard Insert",
          "type": "integer"
        },
        "max_paste_attempt_length": {
          "default": 0,
          "minimum": 0,
          "title": "Max Paste Attempt Length",
          "type": "integer"
        },
        "max_snapshot_growth": {
          "default": 0,
          "description": "Largest growth between consecutive answer snapshots.",
          "minimum": 0,
          "title": "Max Snapshot Growth",
          "type": "integer"
        },
        "max_snapshot_growth_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Time over which that growth happened.",
          "title": "Max Snapshot Growth Ms"
        },
        "mean_sentence_length": {
          "default": 0.0,
          "minimum": 0,
          "title": "Mean Sentence Length",
          "type": "number"
        },
        "non_keyboard_chars": {
          "default": 0,
          "description": "Chars added by paste/drop/replacement/bulk inserts.",
          "minimum": 0,
          "title": "Non Keyboard Chars",
          "type": "integer"
        },
        "paste_attempts": {
          "default": 0,
          "minimum": 0,
          "title": "Paste Attempts",
          "type": "integer"
        },
        "pauses_over_10s": {
          "default": 0,
          "minimum": 0,
          "title": "Pauses Over 10S",
          "type": "integer"
        },
        "pauses_over_2s": {
          "default": 0,
          "minimum": 0,
          "title": "Pauses Over 2S",
          "type": "integer"
        },
        "recorder_restarts_while_writing": {
          "default": 0,
          "description": "Page reloads / recorder restarts strictly inside the writing window.",
          "minimum": 0,
          "title": "Recorder Restarts While Writing",
          "type": "integer"
        },
        "revision_ratio": {
          "default": 0.0,
          "description": "deleted / added (how much the student revised).",
          "minimum": 0,
          "title": "Revision Ratio",
          "type": "number"
        },
        "sentence_count": {
          "default": 0,
          "minimum": 0,
          "title": "Sentence Count",
          "type": "integer"
        },
        "telemetry_gap": {
          "default": false,
          "description": "True when part of this item's keystroke telemetry was probably lost: the recorder restarted (reload) inside the writing window, or answer snapshots grew at typing speed with no writing_stats covering the growth.",
          "title": "Telemetry Gap",
          "type": "boolean"
        },
        "time_to_first_char_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time To First Char Ms"
        },
        "type_token_ratio": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Type Token Ratio",
          "type": "number"
        },
        "typed_chars": {
          "default": 0,
          "description": "Chars added by keyboard input.",
          "minimum": 0,
          "title": "Typed Chars",
          "type": "integer"
        },
        "typed_ratio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "typed / (typed + non_keyboard + unexplained).",
          "title": "Typed Ratio"
        },
        "uncovered_snapshot_growth": {
          "default": 0,
          "description": "Chars the answer snapshots show arriving at human typing speed that no captured input event accounts for (lost telemetry, not pasted text).",
          "minimum": 0,
          "title": "Uncovered Snapshot Growth",
          "type": "integer"
        },
        "unexplained_chars": {
          "default": 0,
          "description": "Final chars not accounted for by ANY captured input event.",
          "minimum": 0,
          "title": "Unexplained Chars",
          "type": "integer"
        },
        "untrusted_inputs": {
          "default": 0,
          "description": "Input events dispatched by a script (isTrusted=false).",
          "minimum": 0,
          "title": "Untrusted Inputs",
          "type": "integer"
        },
        "word_count": {
          "default": 0,
          "minimum": 0,
          "title": "Word Count",
          "type": "integer"
        },
        "writing_span_ms": {
          "default": 0,
          "description": "First focus -> last change.",
          "minimum": 0,
          "title": "Writing Span Ms",
          "type": "integer"
        }
      },
      "required": [
        "item_id"
      ],
      "title": "WritingFeatures",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "title": "Attempt Id",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Why finalize failed (`<ExceptionType>: message`, truncated), set only when status='failed' so the teacher sees the cause and can re-grade.",
      "title": "Error"
    },
    "graded_at": {
      "format": "date-time",
      "title": "Graded At",
      "type": "string"
    },
    "grading": {
      "$ref": "#/$defs/GradingResult",
      "description": "The frozen auto-grade computed once at finalize (objective + LLM writing)."
    },
    "integrity": {
      "anyOf": [
        {
          "$ref": "#/$defs/IntegrityProfile"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The deterministic integrity profile the verdict was computed from."
    },
    "model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "LLM id used for the report, for auditability.",
      "title": "Model Id"
    },
    "skills": {
      "items": {
        "$ref": "#/$defs/SkillReport"
      },
      "title": "Skills",
      "type": "array"
    },
    "status": {
      "default": "complete",
      "enum": [
        "complete",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "default": "",
      "description": "Overall pedagogical summary for the teacher.",
      "title": "Summary",
      "type": "string"
    },
    "verdict": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnalysisVerdict"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Advisory cheating verdict computed once at finalize (Gemini, or the deterministic-only fallback). Never feeds a score."
    }
  },
  "required": [
    "attempt_id",
    "graded_at",
    "grading"
  ],
  "title": "AttemptReport",
  "type": "object"
}
