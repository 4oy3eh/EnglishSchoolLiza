        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Advisory cheating verdict computed once at finalize: the deterministic rule engine, plus an optional LLM second opinion on writing. Never feeds a score."
    }
  },
  "required": [
    "attempt_id",
    "graded_at",
    "grading"
  ],
  "title": "AttemptReport",
  "type": "object"
}
