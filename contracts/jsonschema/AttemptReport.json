{
  "$defs": {
    "AnalysisVerdict": {
      "additionalProperties": false,
      "description": "The advisory integrity verdict stored next to (never inside) the grade.\n\nThe deterministic rule engine is the verdict of record: `suspicion_score`,\n`confidence`, `rules`, `flags` and `summary` come from `app/integrity/rules.py`\nand never from a model. An LLM (when `ANALYSIS_LLM=writing`) only adds a second\nopinion on the WRITING items: then `model_id` is set and `writing[]` holds its\nper-item assessments (floored by the deterministic evidence).",
      "properties": {
        "attempt_id": {
          "title": "Attempt Id",
          "type": "string"
        },
        "confidence": {
          "description": "How complete the telemetry behind the rules was.",
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "error": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why the LLM second opinion is missing (`<ExceptionType>: message`); the rule-engine verdict itself is unaffected.",
          "title": "Error"
        },
        "flags": {
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "input_fingerprint": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fingerprint of the inputs this verdict was computed from (event count, last event id, digest of the analysis context), set by the results layer. An automatic retry reuses a stored LLM verdict whose fingerprint still matches instead of paying for the same analysis again. Not evidence; never shown.",
          "title": "Input Fingerprint"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "LLM id of the WRITING second opinion, for auditability. None = no LLM was used: `writing[]` is then the rule engine's own per-item assessment.",
          "title": "Model Id"
        },
        "rules": {
          "description": "The deterministic rules that fired, strongest first.",
          "items": {
            "$ref": "#/$defs/RuleHit"
          },
          "title": "Rules",
          "type": "array"
        },
        "rules_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Version of the rule engine that produced `rules` / `suspicion_score`. None = a verdict stored before the rule engine existed (its suspicion came from the old formula or from an LLM; a regrade recomputes it).",
          "title": "Rules Version"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "suspicion_score": {
          "description": "Rule-engine suspicion (bounded combination of the hits).",
          "maximum": 1,
          "minimum": 0,
          "title": "Suspicion Score",
          "type": "number"
        },
        "writing": {
          "description": "Per-writing-item outside-help assessments.",
          "items": {
            "$ref": "#/$defs/WritingAssessment"
          },
          "title": "Writing",
          "type": "array"
        }
      },
      "required": [
        "attempt_id",
        "suspicion_score",
        "confidence",
        "summary"
      ],
      "title": "AnalysisVerdict",
      "type": "object"
    },
    "GradingResult": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "title": "Attempt Id",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/ItemGrade"
          },
          "title": "Items",
          "type": "array"
        },
        "max_score": {
          "minimum": 0,
          "title": "Max Score",
          "type": "number"
        },
        "needs_review": {
          "default": false,
          "title": "Needs Review",
          "type": "boolean"
        },
        "score": {
          "minimum": 0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "attempt_id",
        "score",
        "max_score"
      ],
      "title": "GradingResult",
      "type": "object"
    },
    "HiddenInterval": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "duration_ms"
      ],
      "title": "HiddenInterval",
      "type": "object"
    },
    "IntegrityProfile": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "title": "Attempt Id",
          "type": "string"
        },
        "attempt_span_ms": {
          "default": 0,
          "description": "Observed working time: first -> last captured event (trusted time). The denominator of the 'share of the exam spent away from the tab'.",
          "minimum": 0,
          "title": "Attempt Span Ms",
          "type": "integer"
        },
        "device_changed": {
          "default": false,
          "description": "True if the attempt was resumed on a different device.",
          "title": "Device Changed",
          "type": "boolean"
        },
        "device_count": {
          "default": 0,
          "description": "Distinct device fingerprints seen across (re)starts.",
          "minimum": 0,
          "title": "Device Count",
          "type": "integer"
        },
        "fullscreen_exit_count": {
          "default": 0,
          "minimum": 0,
          "title": "Fullscreen Exit Count",
          "type": "integer"
        },
        "hidden_intervals": {
          "items": {
            "$ref": "#/$defs/HiddenInterval"
          },
          "title": "Hidden Intervals",
          "type": "array"
        },
        "overlay_blur_count": {
          "default": 0,
          "description": "Short window blurs with the tab still visible (the pattern a screenshot overlay leaves; also a brief switch to another window).",
          "minimum": 0,
          "title": "Overlay Blur Count",
          "type": "integer"
        },
        "pacing_cv": {
          "default": 0.0,
          "description": "Coefficient of variation of per-question pace.",
          "minimum": 0,
          "title": "Pacing Cv",
          "type": "number"
        },
        "paste_attempt_count": {
          "default": 0,
          "description": "Blocked paste/drop attempts anywhere in the exam.",
          "minimum": 0,
          "title": "Paste Attempt Count",
          "type": "integer"
        },
        "question_timings": {
          "items": {
            "$ref": "#/$defs/QuestionTiming"
          },
          "title": "Question Timings",
          "type": "array"
        },
        "screenshot_key_count": {
          "default": 0,
          "description": "Screenshot key / chord presses captured (best effort).",
          "minimum": 0,
          "title": "Screenshot Key Count",
          "type": "integer"
        },
        "systematicity_rate": {
          "default": 0.0,
          "description": "Fraction of questions showing the pattern.",
          "maximum": 1,
          "minimum": 0,
          "title": "Systematicity Rate",
          "type": "number"
        },
        "total_hidden_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Total Hidden Ms",
          "type": "integer"
        },
        "writing": {
          "description": "Per-writing-item features (open_writing).",
          "items": {
            "$ref": "#/$defs/WritingFeatures"
          },
          "title": "Writing",
          "type": "array"
        }
      },
      "required": [
        "attempt_id"
      ],
      "title": "IntegrityProfile",
      "type": "object"
    },
    "ItemGrade": {
      "additionalProperties": false,
      "properties": {
        "awarded": {
          "minimum": 0,
          "title": "Awarded",
          "type": "number"
        },
        "feedback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Examiner feedback for writing (carried from the LLM grader); for a key_word_transformation the per-half verdict (Russian, e.g. '1/2: \u043f\u0435\u0440\u0432\u0430\u044f \u0447\u0430\u0441\u0442\u044c \u0432\u0435\u0440\u043d\u0430, \u0432\u0442\u043e\u0440\u0430\u044f \u043d\u0435\u0442'); None for other objective items.",
          "title": "Feedback"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "max_points": {
          "description": "Points this item counts toward `max_score`. 0 only for a choose-one writing task that is graded but not counted (the student wrote both).",
          "minimum": 0,
          "title": "Max Points",
          "type": "number"
        },
        "method": {
          "enum": [
            "single_choice",
            "gap_fill",
            "matching",
            "open_writing_llm",
            "open_writing_manual",
            "colour_manual",
            "key_word_transformation"
          ],
          "title": "Method",
          "type": "string"
        },
        "needs_review": {
          "default": false,
          "title": "Needs Review",
          "type": "boolean"
        }
      },
      "required": [
        "item_id",
        "awarded",
        "max_points",
        "method"
      ],
      "title": "ItemGrade",
      "type": "object"
    },
    "QuestionTiming": {
      "additionalProperties": false,
      "properties": {
        "interaction_count": {
          "minimum": 0,
          "title": "Interaction Count",
          "type": "integer"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "latency_ms": {
          "description": "Time spent before first answering.",
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "post_return_latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "visible -> answer latency after a hide.",
          "title": "Post Return Latency Ms"
        }
      },
      "required": [
        "item_id",
        "latency_ms",
        "interaction_count"
      ],
      "title": "QuestionTiming",
      "type": "object"
    },
    "RuleEventRef": {
      "additionalProperties": false,
      "description": "A pointer to one raw event behind a rule hit (the teacher's replay, rule #6).\n\n`at` is the event's trusted time (`server_ts`, else `client_ts`) \u2014 exactly the\n`at` of the dashboard's timeline entry, so a rule card can jump to it.",
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "item_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Id"
        },
        "type": {
          "enum": [
            "visibility_hidden",
            "visibility_visible",
            "window_blur",
            "window_focus",
            "pagehide",
            "interaction",
            "answer_change",
            "audio_play",
            "audio_seek",
            "device_info",
            "field_focus",
            "field_blur",
            "writing_stats",
            "input_burst",
            "paste_attempt",
            "fullscreen_exit",
            "screenshot_key"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "at"
      ],
      "title": "RuleEventRef",
      "type": "object"
    },
    "RuleEvidence": {
      "additionalProperties": false,
      "properties": {
        "events": {
          "description": "Raw events behind the hit (bounded list).",
          "items": {
            "$ref": "#/$defs/RuleEventRef"
          },
          "title": "Events",
          "type": "array"
        },
        "item_ids": {
          "description": "Questions / writing items the hit rests on.",
          "items": {
            "type": "string"
          },
          "title": "Item Ids",
          "type": "array"
        }
      },
      "title": "RuleEvidence",
      "type": "object"
    },
    "RuleHit": {
      "additionalProperties": false,
      "description": "One deterministic integrity rule that fired, with its numbers spelled out.",
      "properties": {
        "code": {
          "description": "Stable machine code, e.g. 'systematic_tab_switching'.",
          "title": "Code",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/RuleEvidence"
        },
        "explanation_ru": {
          "description": "Russian sentence built from the actual numbers of this attempt.",
          "title": "Explanation Ru",
          "type": "string"
        },
        "severity": {
          "enum": [
            "strong",
            "medium",
            "weak"
          ],
          "title": "Severity",
          "type": "string"
        },
        "title_ru": {
          "description": "Short Russian title for the teacher.",
          "title": "Title Ru",
          "type": "string"
        }
      },
      "required": [
        "code",
        "title_ru",
        "severity",
        "explanation_ru"
      ],
      "title": "RuleHit",
      "type": "object"
    },
    "SkillReport": {
      "additionalProperties": false,
      "properties": {
        "max_score": {
          "minimum": 0,
          "title": "Max Score",
          "type": "number"
        },
        "score": {
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "skill": {
          "enum": [
            "reading",
            "use_of_english",
            "listening",
            "writing"
          ],
          "title": "Skill",
          "type": "string"
        },
        "strengths": {
          "description": "What the student did well in this skill.",
          "title": "Strengths",
          "type": "string"
        },
        "weaknesses": {
          "description": "What the student should work on.",
          "title": "Weaknesses",
          "type": "string"
        }
      },
      "required": [
        "skill",
        "score",
        "max_score",
        "strengths",
        "weaknesses"
      ],
      "title": "SkillReport",
      "type": "object"
    },
    "WritingAssessment": {
      "additionalProperties": false,
      "description": "Advisory likelihood that ONE writing answer was produced with outside help.\n\nOutside help = ChatGPT / translator / text copied from another device or tab /\ndictation. Advisory only: no score, never moves a grade (golden rule #2).",
      "properties": {
        "ai_assist_likelihood": {
          "maximum": 1,
          "minimum": 0,
          "title": "Ai Assist Likelihood",
          "type": "number"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "rationale": {
          "default": "",
          "description": "1-2 sentences for the teacher (Russian).",
          "title": "Rationale",
          "type": "string"
        },
        "signals": {
          "description": "The evidence tags the judgment rests on.",
          "items": {
            "type": "string"
          },
          "title": "Signals",
          "type": "array"
        }
      },
      "required": [
        "item_id",
        "ai_assist_likelihood"
      ],
      "title": "WritingAssessment",
      "type": "object"
    },
    "WritingFeatures": {
      "additionalProperties": false,
      "description": "Deterministic per-writing-item features (integrity layer, NO judgment of guilt).\n\nBuilt from the writing-field telemetry (`field_focus` / `writing_stats` /\n`input_burst` / `paste_attempt`), the `answer_change` snapshots, the visibility /\nblur / fullscreen events overlapping the writing window, and cheap text\nstatistics of the submitted text. `flags` are threshold facts documented in\n`app/integrity/CLAUDE.md` (e.g. \"text_appeared_without_typing\"), not a verdict.\nCarries no score (golden rule #2).",
      "properties": {
        "active_typing_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Active Typing Ms",
          "type": "integer"
        },
        "away_count": {
          "default": 0,
          "description": "Hides/blurs during the window.",
          "minimum": 0,
          "title": "Away Count",
          "type": "integer"
        },
        "blur_ms_while_writing": {
          "default": 0,
          "minimum": 0,
          "title": "Blur Ms While Writing",
          "type": "integer"
        },
        "chars_per_active_minute": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chars Per Active Minute"
        },
        "deleted_chars": {
          "default": 0,
          "minimum": 0,
          "title": "Deleted Chars",
          "type": "integer"
        },
        "final_length": {
          "default": 0,
          "description": "Chars in the final text.",
          "minimum": 0,
          "title": "Final Length",
          "type": "integer"
        },
        "flags": {
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "fullscreen_exits_while_writing": {
          "default": 0,
          "minimum": 0,
          "title": "Fullscreen Exits While Writing",
          "type": "integer"
        },
        "has_keystroke_telemetry": {
          "default": false,
          "description": "True when at least one writing_stats event exists.",
          "title": "Has Keystroke Telemetry",
          "type": "boolean"
        },
        "hidden_ms_while_writing": {
          "default": 0,
          "minimum": 0,
          "title": "Hidden Ms While Writing",
          "type": "integer"
        },
        "inter_key_mean_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inter Key Mean Ms"
        },
        "inter_key_p50_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inter Key P50 Ms"
        },
        "inter_key_p90_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inter Key P90 Ms"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "keystrokes": {
          "default": 0,
          "minimum": 0,
          "title": "Keystrokes",
          "type": "integer"
        },
        "long_word_share": {
          "default": 0.0,
          "description": "Share of words with >= 8 letters.",
          "maximum": 1,
          "minimum": 0,
          "title": "Long Word Share",
          "type": "number"
        },
        "max_non_keyboard_insert": {
          "default": 0,
          "minimum": 0,
          "title": "Max Non Keyboard Insert",
          "type": "integer"
        },
        "max_paste_attempt_length": {
          "default": 0,
          "minimum": 0,
          "title": "Max Paste Attempt Length",
          "type": "integer"
        },
        "max_snapshot_growth": {
          "default": 0,
          "description": "Largest growth between consecutive answer snapshots.",
          "minimum": 0,
          "title": "Max Snapshot Growth",
          "type": "integer"
        },
        "max_snapshot_growth_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Time over which that growth happened.",
          "title": "Max Snapshot Growth Ms"
        },
        "mean_sentence_length": {
          "default": 0.0,
          "minimum": 0,
          "title": "Mean Sentence Length",
          "type": "number"
        },
        "non_keyboard_chars": {
          "default": 0,
          "description": "Chars added by paste/drop/replacement/bulk inserts.",
          "minimum": 0,
          "title": "Non Keyboard Chars",
          "type": "integer"
        },
        "paste_attempts": {
          "default": 0,
          "minimum": 0,
          "title": "Paste Attempts",
          "type": "integer"
        },
        "pauses_over_10s": {
          "default": 0,
          "minimum": 0,
          "title": "Pauses Over 10S",
          "type": "integer"
        },
        "pauses_over_2s": {
          "default": 0,
          "minimum": 0,
          "title": "Pauses Over 2S",
          "type": "integer"
        },
        "recorder_restarts_while_writing": {
          "default": 0,
          "description": "Page reloads / recorder restarts strictly inside the writing window.",
          "minimum": 0,
          "title": "Recorder Restarts While Writing",
          "type": "integer"
        },
        "revision_ratio": {
          "default": 0.0,
          "description": "deleted / added (how much the student revised).",
          "minimum": 0,
          "title": "Revision Ratio",
          "type": "number"
        },
        "sentence_count": {
          "default": 0,
          "minimum": 0,
          "title": "Sentence Count",
          "type": "integer"
        },
        "telemetry_gap": {
          "default": false,
          "description": "True when part of this item's keystroke telemetry was probably lost: the recorder restarted (reload) inside the writing window, or answer snapshots grew at typing speed with no writing_stats covering the growth.",
          "title": "Telemetry Gap",
          "type": "boolean"
        },
        "time_to_first_char_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time To First Char Ms"
        },
        "type_token_ratio": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Type Token Ratio",
          "type": "number"
        },
        "typed_chars": {
          "default": 0,
          "description": "Chars added by keyboard input.",
          "minimum": 0,
          "title": "Typed Chars",
          "type": "integer"
        },
        "typed_ratio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "typed / (typed + non_keyboard + unexplained).",
          "title": "Typed Ratio"
        },
        "uncovered_snapshot_growth": {
          "default": 0,
          "description": "Chars the answer snapshots show arriving at human typing speed that no captured input event accounts for (lost telemetry, not pasted text).",
          "minimum": 0,
          "title": "Uncovered Snapshot Growth",
          "type": "integer"
        },
        "unexplained_chars": {
          "default": 0,
          "description": "Final chars not accounted for by ANY captured input event.",
          "minimum": 0,
          "title": "Unexplained Chars",
          "type": "integer"
        },
        "untrusted_inputs": {
          "default": 0,
          "description": "Input events dispatched by a script (isTrusted=false).",
          "minimum": 0,
          "title": "Untrusted Inputs",
          "type": "integer"
        },
        "word_count": {
          "default": 0,
          "minimum": 0,
          "title": "Word Count",
          "type": "integer"
        },
        "writing_span_ms": {
          "default": 0,
          "description": "First focus -> last change.",
          "minimum": 0,
          "title": "Writing Span Ms",
          "type": "integer"
        }
      },
      "required": [
        "item_id"
      ],
      "title": "WritingFeatures",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "title": "Attempt Id",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Why finalize failed (`<ExceptionType>: message`, truncated), set only when status='failed' so the teacher sees the cause and can re-grade.",
      "title": "Error"
    },
    "graded_at": {
      "format": "date-time",
      "title": "Graded At",
      "type": "string"
    },
    "grading": {
      "$ref": "#/$defs/GradingResult",
      "description": "The frozen auto-grade computed once at finalize (objective + LLM writing)."
    },
    "integrity": {
      "anyOf": [
        {
          "$ref": "#/$defs/IntegrityProfile"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The deterministic integrity profile the verdict was computed from."
    },
    "model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "LLM id used for the report, for auditability.",
      "title": "Model Id"
    },
    "skills": {
      "items": {
        "$ref": "#/$defs/SkillReport"
      },
      "title": "Skills",
      "type": "array"
    },
    "status": {
      "default": "complete",
      "enum": [
        "complete",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "default": "",
      "description": "Overall pedagogical summary for the teacher.",
      "title": "Summary",
      "type": "string"
    },
    "verdict": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnalysisVerdict"
