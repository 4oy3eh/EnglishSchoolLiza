{
  "$defs": {
    "ClientColourTaskItem": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "item_type": {
          "const": "colour_task",
          "default": "colour_task",
          "title": "Item Type",
          "type": "string"
        },
        "palette": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Palette",
          "type": "array"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        }
      },
      "required": [
        "id",
        "prompt",
        "asset_id",
        "palette"
      ],
      "title": "ClientColourTaskItem",
      "type": "object"
    },
    "ClientDrawingItem": {
      "additionalProperties": false,
      "description": "The student's drawing canvas \u2014 no `target`. For `mode=\"lines\"` the canvas\nframes `square` (where the square sits on the picture, normalized). Save the\nstrokes as a JSON string {\"w\", \"h\", \"strokes\": [[[x, y], ...], ...]}.",
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "item_type": {
          "const": "drawing",
          "default": "drawing",
          "title": "Item Type",
          "type": "string"
        },
        "mode": {
          "enum": [
            "region",
            "lines"
          ],
          "title": "Mode",
          "type": "string"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "square": {
          "anyOf": [
            {
              "$ref": "#/$defs/SquareBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "prompt",
        "asset_id",
        "mode"
      ],
      "title": "ClientDrawingItem",
      "type": "object"
    },
    "ClientGapFillItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image"
        },
        "item_type": {
          "const": "gap_fill",
          "default": "gap_fill",
          "title": "Item Type",
          "type": "string"
        },
        "max_words": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "'Use no more than N word(s)' (None = no limit shown).",
          "title": "Max Words"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "stem_word": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Word-formation stem shown beside the gap, e.g. 'COMPETE'.",
          "title": "Stem Word"
        }
      },
      "required": [
        "id",
        "prompt"
      ],
      "title": "ClientGapFillItem",
      "type": "object"
    },
    "ClientImageOption": {
      "additionalProperties": false,
      "properties": {
        "alt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alt"
        },
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "kind": {
          "const": "image",
          "default": "image",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "asset_id"
      ],
      "title": "ClientImageOption",
      "type": "object"
    },
    "ClientKeyWordTransformationItem": {
      "additionalProperties": false,
      "description": "The student's view of a key word transformation - no `answers`.\n\nRender: the lead-in `prompt`, the `key_word` (bold capitals), then\n`gapped_sentence` split at its first `KWT_GAP_RE` match with ONE text input in\nthe gap, plus the rubric \"Use between `min_words` and `max_words` words,\nincluding the word given.\" The answer is saved as plain text (the words typed\ninto the gap only).",
      "properties": {
        "gapped_sentence": {
          "title": "Gapped Sentence",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "item_type": {
          "const": "key_word_transformation",
          "default": "key_word_transformation",
          "title": "Item Type",
          "type": "string"
        },
        "key_word": {
          "title": "Key Word",
          "type": "string"
        },
        "max_words": {
          "minimum": 1,
          "title": "Max Words",
          "type": "integer"
        },
        "min_words": {
          "minimum": 1,
          "title": "Min Words",
          "type": "integer"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        }
      },
      "required": [
        "id",
        "prompt",
        "key_word",
        "gapped_sentence",
        "min_words",
        "max_words"
      ],
      "title": "ClientKeyWordTransformationItem",
      "type": "object"
    },
    "ClientMarkToggleItem": {
      "additionalProperties": false,
      "description": "A row to mark / leave unmarked \u2014 no `correct`. Save \"1\" (marked) / \"0\".",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image"
        },
        "item_type": {
          "const": "mark_toggle",
          "default": "mark_toggle",
          "title": "Item Type",
          "type": "string"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        }
      },
      "required": [
        "id",
        "prompt"
      ],
      "title": "ClientMarkToggleItem",
      "type": "object"
    },
    "ClientMatchingItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "item_type": {
          "const": "matching",
          "default": "matching",
          "title": "Item Type",
          "type": "string"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        }
      },
      "required": [
        "id",
        "prompt"
      ],
      "title": "ClientMatchingItem",
      "type": "object"
    },
    "ClientOpenWritingItem": {
      "additionalProperties": false,
      "properties": {
        "bullet_points": {
          "items": {
            "type": "string"
          },
          "title": "Bullet Points",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "item_type": {
          "const": "open_writing",
          "default": "open_writing",
          "title": "Item Type",
          "type": "string"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "word_min": {
          "exclusiveMinimum": 0,
          "title": "Word Min",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "prompt",
        "word_min"
      ],
      "title": "ClientOpenWritingItem",
      "type": "object"
    },
    "ClientSingleChoiceItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image"
        },
        "item_type": {
          "const": "single_choice",
          "default": "single_choice",
          "title": "Item Type",
          "type": "string"
        },
        "options": {
          "items": {
            "discriminator": {
              "mapping": {
                "image": "#/$defs/ClientImageOption",
                "text": "#/$defs/ClientTextOption"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ClientTextOption"
              },
              {
                "$ref": "#/$defs/ClientImageOption"
              }
            ]
          },
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        }
      },
      "required": [
        "id",
        "prompt",
        "options"
      ],
      "title": "ClientSingleChoiceItem",
      "type": "object"
    },
    "ClientTextOption": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "text",
          "default": "text",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "ClientTextOption",
      "type": "object"
    },
    "SquareBox": {
      "additionalProperties": false,
      "description": "Where the reference square sits on the picture (normalized image coords).\nServed to the client (the canvas frame) \u2014 it is not answer data.",
      "properties": {
        "h": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "H",
          "type": "number"
        },
        "w": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "W",
          "type": "number"
        },
        "x": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "title": "SquareBox",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "colour_task": "#/$defs/ClientColourTaskItem",
      "drawing": "#/$defs/ClientDrawingItem",
      "gap_fill": "#/$defs/ClientGapFillItem",
      "key_word_transformation": "#/$defs/ClientKeyWordTransformationItem",
      "mark_toggle": "#/$defs/ClientMarkToggleItem",
      "matching": "#/$defs/ClientMatchingItem",
      "open_writing": "#/$defs/ClientOpenWritingItem",
      "single_choice": "#/$defs/ClientSingleChoiceItem"
    },
    "propertyName": "item_type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ClientSingleChoiceItem"
    },
    {
      "$ref": "#/$defs/ClientGapFillItem"
    },
    {
      "$ref": "#/$defs/ClientMatchingItem"
    },
    {
      "$ref": "#/$defs/ClientOpenWritingItem"
    },
    {
      "$ref": "#/$defs/ClientColourTaskItem"
    },
    {
      "$ref": "#/$defs/ClientKeyWordTransformationItem"
    },
    {
      "$ref": "#/$defs/ClientMarkToggleItem"
    },
    {
      "$ref": "#/$defs/ClientDrawingItem"
    }
  ]
}
